# Copier ce fichier en .env.local (npm run dev) ET en .dev.vars (npm run preview) ; jamais versionnés.
# En production : npx wrangler secret put ANTHROPIC_API_KEY
# La base D1 n'a pas de variable : elle est déclarée dans wrangler.jsonc (liaison DB).

# Clé de l'API Claude, utilisée uniquement côté serveur
ANTHROPIC_API_KEY=

# Nombre de générations IA par compte et par 24 h (10 par défaut)
QUOTA_GENERATIONS_JOUR=10
