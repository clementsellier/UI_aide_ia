# Copier ce fichier en .env.local (jamais versionné) et renseigner les valeurs.

# Base PostgreSQL (valeurs de docker-compose.dev.yml en local) : pas encore utilisée par la version de test
DATABASE_URL=postgres://aide_ia:aide_ia@localhost:5432/aide_ia

# Clé de l'API Claude, utilisée uniquement côté serveur
ANTHROPIC_API_KEY=

# Nombre de générations IA par compte et par 24 h (10 par défaut)
QUOTA_GENERATIONS_JOUR=10
